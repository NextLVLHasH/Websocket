// Skill Tree UI
// Displays the skill tree with nodes, details panel, and unlock functionality

// ==================== Style Definitions ====================

@TitleStyle = LabelStyle(
    FontSize: 22,
    TextColor: #FFD700,
    HorizontalAlignment: Center,
    VerticalAlignment: Center,
    RenderBold: true
);

@SubtitleStyle = LabelStyle(
    FontSize: 14,
    TextColor: #AAAAAA,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@SkillPointsStyle = LabelStyle(
    FontSize: 16,
    TextColor: #FF55FF,
    HorizontalAlignment: Center,
    VerticalAlignment: Center,
    RenderBold: true
);

// Skill node states
@UnlockedSkillStyle = LabelStyle(
    FontSize: 12,
    TextColor: #55FF55,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@AvailableSkillStyle = LabelStyle(
    FontSize: 12,
    TextColor: #FFFF55,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@LockedSkillStyle = LabelStyle(
    FontSize: 12,
    TextColor: #888888,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@SelectedSkillStyle = LabelStyle(
    FontSize: 12,
    TextColor: #FFFFFF,
    HorizontalAlignment: Center,
    VerticalAlignment: Center,
    RenderBold: true
);

// Details panel styles
@DetailsTitleStyle = LabelStyle(
    FontSize: 18,
    TextColor: #FFFFFF,
    HorizontalAlignment: Start,
    VerticalAlignment: Center,
    RenderBold: true
);

@DetailsDescStyle = LabelStyle(
    FontSize: 12,
    TextColor: #CCCCCC,
    HorizontalAlignment: Start,
    VerticalAlignment: Start
);

@DetailsLabelStyle = LabelStyle(
    FontSize: 12,
    TextColor: #AAAAAA,
    HorizontalAlignment: Start,
    VerticalAlignment: Center
);

@DetailsValueStyle = LabelStyle(
    FontSize: 12,
    TextColor: #FFFFFF,
    HorizontalAlignment: End,
    VerticalAlignment: Center
);

@TypeActiveStyle = LabelStyle(
    FontSize: 12,
    TextColor: #FF5555,
    HorizontalAlignment: End,
    VerticalAlignment: Center
);

@TypePassiveStyle = LabelStyle(
    FontSize: 12,
    TextColor: #55FF55,
    HorizontalAlignment: End,
    VerticalAlignment: Center
);

@TypeToggleStyle = LabelStyle(
    FontSize: 12,
    TextColor: #55FFFF,
    HorizontalAlignment: End,
    VerticalAlignment: Center
);

@TypeUltimateStyle = LabelStyle(
    FontSize: 12,
    TextColor: #FF55FF,
    HorizontalAlignment: End,
    VerticalAlignment: Center
);

@RequirementMetStyle = LabelStyle(
    FontSize: 11,
    TextColor: #55FF55,
    HorizontalAlignment: Start,
    VerticalAlignment: Center
);

@RequirementUnmetStyle = LabelStyle(
    FontSize: 11,
    TextColor: #FF5555,
    HorizontalAlignment: Start,
    VerticalAlignment: Center
);

@ButtonTextStyle = LabelStyle(
    FontSize: 14,
    TextColor: #FFFFFF,
    HorizontalAlignment: Center,
    VerticalAlignment: Center,
    RenderBold: true
);

@ButtonDisabledStyle = LabelStyle(
    FontSize: 14,
    TextColor: #666666,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@CloseButtonStyle = LabelStyle(
    FontSize: 16,
    TextColor: #FF5555,
    HorizontalAlignment: Center,
    VerticalAlignment: Center,
    RenderBold: true
);

// ==================== Main Layout ====================

Group {
    Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
    LayoutMode: Center;

    // Main container
    Group #MainContainer {
        Anchor: (Width: 700, Height: 500);
        Background: #1a1a2e(0.95);

        // Top border decoration
        Group #TopBorder {
            Anchor: (Top: 0, Left: 0, Right: 0, Height: 3);
            Background: #FFD700;
        }

        // Bottom border decoration
        Group #BottomBorder {
            Anchor: (Bottom: 0, Left: 0, Right: 0, Height: 3);
            Background: #FFD700;
        }

        // Header section
        Group #HeaderSection {
            Anchor: (Top: 8, Left: 16, Right: 16, Height: 60);

            // Close button
            Button #CloseButton {
                Anchor: (Top: 0, Right: 0, Width: 32, Height: 32);
                Background: #442222;

                Label #CloseButtonText {
                    Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
                    Style: @CloseButtonStyle;
                    Text: "X";
                }
            }

            // Tree title
            Label #TreeTitle {
                Anchor: (Top: 4, Left: 0, Right: 40, Height: 28);
                Style: @TitleStyle;
                Text: "Skill Tree";
            }

            // Available skill points
            Group #SkillPointsContainer {
                Anchor: (Top: 36, Left: 0, Right: 0, Height: 20);

                Label #SkillPointsLabel {
                    Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
                    Style: @SkillPointsStyle;
                    Text: "Available Skill Points: 0";
                }
            }
        }

        // Separator
        Group #HeaderSeparator {
            Anchor: (Top: 72, Left: 16, Right: 16, Height: 1);
            Background: #444444;
        }

        // Content area (skill grid + details panel)
        Group #ContentArea {
            Anchor: (Top: 80, Left: 16, Right: 16, Bottom: 16);

            // ==================== Skill Grid Panel (Left) ====================
            Group #SkillGridPanel {
                Anchor: (Top: 0, Left: 0, Width: 400, Bottom: 0);
                Background: #0d0d1a(0.5);

                // Grid header
                Label #GridHeader {
                    Anchor: (Top: 8, Left: 8, Right: 8, Height: 20);
                    Style: @SubtitleStyle;
                    Text: "Skills";
                }

                // Scrollable skill node container
                Group #SkillNodesContainer {
                    Anchor: (Top: 36, Left: 8, Right: 8, Bottom: 8);

                    // Tier 0 row
                    Group #Tier0 {
                        Anchor: (Top: 0, Left: 0, Right: 0, Height: 60);

                        // Skill nodes will be populated dynamically
                        // Template skill node
                        Button #SkillNodeR0C0 {
                            Anchor: (Top: 4, Left: 4, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR0C0 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR0C0 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR0C1 {
                            Anchor: (Top: 4, Left: 60, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR0C1 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR0C1 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR0C2 {
                            Anchor: (Top: 4, Left: 116, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR0C2 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR0C2 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR0C3 {
                            Anchor: (Top: 4, Left: 172, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR0C3 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR0C3 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR0C4 {
                            Anchor: (Top: 4, Left: 228, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR0C4 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR0C4 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }
                    }

                    // Tier 1 row
                    Group #Tier1 {
                        Anchor: (Top: 64, Left: 0, Right: 0, Height: 60);

                        Button #SkillNodeR1C0 {
                            Anchor: (Top: 4, Left: 4, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR1C0 {
