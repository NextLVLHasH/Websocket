                            }
                        }

                        Button #SkillNodeR1C4 {
                            Anchor: (Top: 4, Left: 228, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR1C4 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR1C4 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }
                    }

                    // Tier 2 row
                    Group #Tier2 {
                        Anchor: (Top: 128, Left: 0, Right: 0, Height: 60);

                        Button #SkillNodeR2C0 {
                            Anchor: (Top: 4, Left: 4, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR2C0 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR2C0 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR2C1 {
                            Anchor: (Top: 4, Left: 60, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR2C1 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR2C1 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR2C2 {
                            Anchor: (Top: 4, Left: 116, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR2C2 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR2C2 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR2C3 {
                            Anchor: (Top: 4, Left: 172, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR2C3 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR2C3 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR2C4 {
                            Anchor: (Top: 4, Left: 228, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR2C4 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR2C4 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }
                    }

                    // Tier 3 row
                    Group #Tier3 {
                        Anchor: (Top: 192, Left: 0, Right: 0, Height: 60);

                        Button #SkillNodeR3C0 {
                            Anchor: (Top: 4, Left: 4, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR3C0 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR3C0 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR3C1 {
                            Anchor: (Top: 4, Left: 60, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR3C1 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR3C1 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR3C2 {
                            Anchor: (Top: 4, Left: 116, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR3C2 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR3C2 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR3C3 {
                            Anchor: (Top: 4, Left: 172, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR3C3 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR3C3 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR3C4 {
                            Anchor: (Top: 4, Left: 228, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR3C4 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR3C4 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }
                    }

                    // Tier 4 row
                    Group #Tier4 {
                        Anchor: (Top: 256, Left: 0, Right: 0, Height: 60);

                        Button #SkillNodeR4C0 {
                            Anchor: (Top: 4, Left: 4, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR4C0 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR4C0 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR4C1 {
                            Anchor: (Top: 4, Left: 60, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR4C1 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR4C1 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR4C2 {
                            Anchor: (Top: 4, Left: 116, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR4C2 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR4C2 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
