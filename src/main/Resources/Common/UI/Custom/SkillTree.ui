                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR1C1 {
                            Anchor: (Top: 4, Left: 60, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR1C1 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR1C1 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR1C2 {
                            Anchor: (Top: 4, Left: 116, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR1C2 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR1C2 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }

                        Button #SkillNodeR1C3 {
                            Anchor: (Top: 4, Left: 172, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR1C3 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR1C3 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
