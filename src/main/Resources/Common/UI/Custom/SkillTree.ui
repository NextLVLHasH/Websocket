                            Anchor: (Top: 4, Left: 228, Width: 52, Height: 52);
                            Background: #333344;

                            Group #SkillIconR4C4 {
                                Anchor: (Top: 4, Left: 4, Right: 4, Height: 28);
                                Background: #555566;
                            }

                            Label #SkillNameR4C4 {
                                Anchor: (Bottom: 2, Left: 2, Right: 2, Height: 16);
                                Style: @LockedSkillStyle;
                                Text: "";
                            }
                        }
                    }
                }
            }

            // ==================== Details Panel (Right) ====================
            Group #DetailsPanel {
                Anchor: (Top: 0, Right: 0, Width: 256, Bottom: 0);
                Background: #0d0d1a(0.5);

                // No skill selected message
                Label #NoSelectionMessage {
                    Anchor: (Left: 8, Top: 8, Right: 8, Bottom: 8);
                    Style: @SubtitleStyle;
                    Text: "Select a skill to view details";
                }

                // Skill details container (shown when a skill is selected)
                Group #SkillDetailsContainer {
                    Anchor: (Left: 8, Top: 8, Right: 8, Bottom: 8);
                    Visible: false;

                    // Skill name
                    Label #SelectedSkillName {
                        Anchor: (Top: 0, Left: 0, Right: 0, Height: 24);
                        Style: @DetailsTitleStyle;
                        Text: "Skill Name";
                    }

                    // Skill type
                    Group #SkillTypeRow {
                        Anchor: (Top: 28, Left: 0, Right: 0, Height: 18);

                        Label #TypeLabel {
                            Anchor: (Left: 0, Top: 0, Width: 60, Bottom: 0);
                            Style: @DetailsLabelStyle;
                            Text: "Type:";
                        }

                        Label #SkillType {
                            Anchor: (Right: 0, Top: 0, Width: 100, Bottom: 0);
                            Style: @TypeActiveStyle;
                            Text: "Active";
                        }
                    }

                    // Separator
                    Group #DetailsSeparator1 {
                        Anchor: (Top: 50, Left: 0, Right: 0, Height: 1);
                        Background: #333344;
                    }

                    // Description
                    Label #SkillDescription {
                        Anchor: (Top: 56, Left: 0, Right: 0, Height: 48);
                        Style: @DetailsDescStyle;
                        Text: "Skill description goes here...";
                    }

                    // Separator
                    Group #DetailsSeparator2 {
                        Anchor: (Top: 108, Left: 0, Right: 0, Height: 1);
                        Background: #333344;
                    }

                    // Requirements section
                    Label #RequirementsHeader {
                        Anchor: (Top: 114, Left: 0, Right: 0, Height: 18);
                        Style: @DetailsLabelStyle;
                        Text: "Requirements:";
                    }

                    // Level requirement
                    Label #LevelRequirement {
                        Anchor: (Top: 134, Left: 8, Right: 0, Height: 16);
                        Style: @RequirementMetStyle;
                        Text: "Level 1";
                    }

                    // Skill point cost
                    Label #SkillPointCost {
                        Anchor: (Top: 152, Left: 8, Right: 0, Height: 16);
                        Style: @RequirementMetStyle;
                        Text: "1 Skill Point";
                    }

                    // Prerequisites
                    Label #Prerequisites {
                        Anchor: (Top: 170, Left: 8, Right: 0, Height: 16);
                        Style: @RequirementMetStyle;
                        Text: "None";
                    }

                    // Separator
                    Group #DetailsSeparator3 {
                        Anchor: (Top: 192, Left: 0, Right: 0, Height: 1);
                        Background: #333344;
                    }

                    // Costs section (for active skills)
                    Group #CostsSection {
                        Anchor: (Top: 198, Left: 0, Right: 0, Height: 60);

                        Label #CostsHeader {
                            Anchor: (Top: 0, Left: 0, Right: 0, Height: 18);
                            Style: @DetailsLabelStyle;
                            Text: "Costs:";
                        }

                        // Mana cost
                        Group #ManaCostRow {
                            Anchor: (Top: 20, Left: 0, Right: 0, Height: 16);

                            Label #ManaCostLabel {
                                Anchor: (Left: 8, Top: 0, Width: 80, Bottom: 0);
                                Style: @DetailsLabelStyle;
                                Text: "Mana:";
                            }

                            Label #ManaCostValue {
                                Anchor: (Right: 0, Top: 0, Width: 60, Bottom: 0);
                                Style: @DetailsValueStyle;
                                Text: "0";
                            }
                        }

                        // Stamina cost
                        Group #StaminaCostRow {
                            Anchor: (Top: 38, Left: 0, Right: 0, Height: 16);

                            Label #StaminaCostLabel {
                                Anchor: (Left: 8, Top: 0, Width: 80, Bottom: 0);
                                Style: @DetailsLabelStyle;
                                Text: "Stamina:";
                            }

                            Label #StaminaCostValue {
                                Anchor: (Right: 0, Top: 0, Width: 60, Bottom: 0);
                                Style: @DetailsValueStyle;
                                Text: "0";
                            }
                        }
                    }

                    // Cooldown
                    Group #CooldownRow {
                        Anchor: (Top: 262, Left: 0, Right: 0, Height: 16);

                        Label #CooldownLabel {
                            Anchor: (Left: 0, Top: 0, Width: 80, Bottom: 0);
                            Style: @DetailsLabelStyle;
                            Text: "Cooldown:";
                        }

                        Label #CooldownValue {
                            Anchor: (Right: 0, Top: 0, Width: 60, Bottom: 0);
                            Style: @DetailsValueStyle;
                            Text: "0s";
                        }
                    }

                    // Unlock button
                    Button #UnlockButton {
                        Anchor: (Bottom: 0, Left: 0, Right: 0, Height: 36);
                        Background: #224422;

                        Label #UnlockButtonText {
                            Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
                            Style: @ButtonTextStyle;
                            Text: "Unlock Skill";
                        }
                    }

                    // Unlock button disabled state
                    Button #UnlockButtonDisabled {
                        Anchor: (Bottom: 0, Left: 0, Right: 0, Height: 36);
                        Background: #222222;
                        Visible: false;

                        Label #UnlockButtonDisabledText {
                            Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
                            Style: @ButtonDisabledStyle;
                            Text: "Cannot Unlock";
                        }
                    }

                    // Already unlocked indicator
                    Label #AlreadyUnlocked {
                        Anchor: (Bottom: 0, Left: 0, Right: 0, Height: 36);
                        Style: @UnlockedSkillStyle;
                        Text: "Already Unlocked";
                        Visible: false;
                    }
                }
            }
        }
    }
}
