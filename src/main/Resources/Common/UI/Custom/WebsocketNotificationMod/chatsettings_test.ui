// Chat Settings Page

@LabelStyle = LabelStyle(
    FontSize: 14,
    TextColor: #CCCCCC,
    HorizontalAlignment: Start,
    VerticalAlignment: Center
);

@ValueStyle = LabelStyle(
    FontSize: 14,
    TextColor: #FFFFFF,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@ButtonLabelStyle = LabelStyle(
    FontSize: 14,
    TextColor: #FFFFFF,
    RenderBold: true,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@InputStyle = InputFieldStyle(
    FontSize: 14,
    TextColor: #FFFFFF
);

Group {
    Anchor: (Left: 0, Top: 0, Right: 0, Bottom: 0);
    LayoutMode: Center;

    Group #SettingsContainer {
        Anchor: (Width: 380, Height: 380);
        Background: #0b0f14(0.95);

        Group #SettingsContent {
            Anchor: (Left: 16, Top: 16, Right: 16, Bottom: 16);

            // Title
            Label #Title {
                Anchor: (Top: 0, Left: 0, Right: 0, Height: 32);
                Style: (FontSize: 20, TextColor: #FFFFFF, HorizontalAlignment: Center, RenderBold: true);
                Text: "Chat Settings";
            }

            // Opacity Section
            Label #OpacityLabel {
                Anchor: (Top: 48, Left: 0, Width: 100, Height: 24);
                Style: @LabelStyle;
                Text: "Chat Opacity:";
            }

            Label #OpacityValue {
                Anchor: (Top: 48, Left: 110, Width: 60, Height: 24);
                Style: @ValueStyle;
                Text: "100%";
            }

            Button #ToggleOpacityButton {
                Anchor: (Top: 48, Right: 0, Width: 80, Height: 24);
                Background: #6B4423;

                Label {
                    Anchor: (Full: 0);
                    Style: @ButtonLabelStyle;
                    Text: "NEXT";
                }
            }

            // Hidden Toggle Section
            Label #HiddenLabel {
                Anchor: (Top: 88, Left: 0, Width: 140, Height: 24);
                Style: @LabelStyle;
                Text: "Hide default chat:";
            }

            Label #HiddenValue {
                Anchor: (Top: 88, Left: 150, Width: 50, Height: 24);
                Style: @ValueStyle;
                Text: "OFF";
            }

            Button #ToggleHiddenButton {
                Anchor: (Top: 88, Right: 0, Width: 80, Height: 24);
                Background: #6B4423;

                Label {
                    Anchor: (Full: 0);
                    Style: @ButtonLabelStyle;
                    Text: "TOGGLE";
                }
            }

            // Discord Link Section - Separator
            Group #Separator {
                Anchor: (Top: 128, Left: 0, Right: 0, Height: 1);
                Background: #555555;
            }

            Label #DiscordSectionLabel {
                Anchor: (Top: 140, Left: 0, Right: 0, Height: 24);
                Style: (FontSize: 16, TextColor: #7289DA, HorizontalAlignment: Center, RenderBold: true);
                Text: "Discord Link";
            }

            // Link Status
            Label #LinkStatusLabel {
                Anchor: (Top: 168, Left: 0, Right: 0, Height: 20);
                Style: (FontSize: 12, TextColor: #AAAAAA, HorizontalAlignment: Center);
                Text: "Not linked";
            }

            // Discord Username Input
            Label #DiscordUsernameLabel {
                Anchor: (Top: 196, Left: 0, Width: 100, Height: 28);
                Style: @LabelStyle;
                Text: "Username:";
            }

            Group #DiscordInputBackground {
                Anchor: (Top: 196, Left: 100, Right: 90, Height: 28);
                Background: #3a3f47;

                TextField #DiscordUsernameInput {
                    Anchor: (Left: 8, Top: 4, Right: 8, Bottom: 4);
                    Style: @InputStyle;
                    PlaceholderText: "Discord username...";
                }
            }

            Button #LinkButton {
                Anchor: (Top: 196, Right: 0, Width: 80, Height: 28);
                Background: #7289DA;

                Label {
                    Anchor: (Full: 0);
                    Style: @ButtonLabelStyle;
                    Text: "LINK";
                }
            }

            // Save Button
            Button #SaveButton {
                Anchor: (Left: 0, Bottom: 0, Width: 150, Height: 40);
                Background: #5A8C3A;

                Label {
                    Anchor: (Full: 0);
                    Style: @ButtonLabelStyle;
                    Text: "SAVE";
                }
            }

            // Cancel Button
            Button #CancelButton {
                Anchor: (Right: 0, Bottom: 0, Width: 150, Height: 40);
                Background: #8C3A3A;

                Label {
                    Anchor: (Full: 0);
                    Style: @ButtonLabelStyle;
                    Text: "CANCEL";
                }
            }
        }
    }
}
